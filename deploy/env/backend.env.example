# =============================================================================
# Backend production env — copy thành /var/www/sai-gon-work/backend/.env
# =============================================================================

# Database — đổi user/pass/db name theo MySQL trên server
DATABASE_URL="mysql://saigon_wok_user:CHANGE_ME@localhost:3306/saigon_wok"

# Server
PORT=4000
NODE_ENV=production

# CORS — CHỈ origin production (qua nginx). Không để * vì credentials=include
CORS_ORIGIN=https://sai-gon-work.lemiex.us

# Public URL — dùng trong email tracking link
PUBLIC_APP_URL=https://sai-gon-work.lemiex.us

# JWT — TẠO MỚI cho production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES_HEX_DIFFERENT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email — đổi sang account thật cho production
EMAIL_FROM=Sai Gon Wok <no-reply@saigonwok.de>
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

# Routing (OSRM public)
OSRM_URL=https://router.project-osrm.org
